{
  "header": "A minimal but valid pyvoa database description, used by the tests",
  "geoinfo": {
    "granularity": "country",
    "iso3": "FRA",
    "locationmode": "code"
  },
  "datasets": [
    {
      "urldata": "https://example.org/frozen/tiny.csv",
      "separator": ",",
      "columns": [
        {
          "name": "date"
        },
        {
          "name": "where",
          "alias": "location"
        },
        {
          "name": "tot_cases",
          "alias": "cases",
          "description": "Cumulative number of confirmed cases"
        },
        {
          "name": "tot_deaths",
          "alias": "deaths"
        }
      ]
    }
  ]
}
