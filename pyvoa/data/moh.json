{
  "header": "Malaysia, Ministry of Health (MoH) database, by state",
    "geoinfo": {
    "granularity": "subregion",
    "iso3": "MYS",
    "locationmode":"name"
  },
  "replace":{
          "W.P. Kuala Lumpur":"Wilayah Persekutuan",
          "W.P. Putrajaya":"Wilayah Persekutuan",
          "W.P. Labuan":"Wilayah Persekutuan Labuan"
  	 },

  "datasets": [
  	{	
	 "urldata": "https://zenodo.org/records/23698918/files/moh_cases_state.csv?content",
	 "urlparent":"https://raw.githubusercontent.com/MoH-Malaysia/covid19-public/main/epidemic/cases_state.csv",
	 "separator":",",
  	 "columns": [
    			{
		   "name":"where",
    		   "alias":"state"	
			},
			{"name":"date"},
			{
			       "name":"tot_cases",
			       "alias":"cases_new",
			       "cumulative":true
		       }
	 ]
	},
{
         "urldata": "https://zenodo.org/records/23698918/files/moh_deaths_state.csv?content",
         "urlparent":"https://raw.githubusercontent.com/MoH-Malaysia/covid19-public/main/epidemic/moh_deaths_state.csv",
         "archiveonly":"the file was renamed upstream (epidemic/deaths_state.csv), its columns not yet checked",
         "separator":",",
         "columns": [
                        {
                   "name":"where",
                   "alias":"state"                
                        },
                        {"name":"date"},
			{
			       "name":"tot_deaths",
			       "alias":"deaths_new",
			       "cumulative":true
		       }
         ]
        },
	{
         "urldata": "https://zenodo.org/records/23698918/files/moh_icu.csv?content",
         "urlparent":"https://raw.githubusercontent.com/MoH-Malaysia/covid19-public/main/epidemic/icu.csv",
         "separator":",",
         "columns": [
                        {
                   "name":"where",
                   "alias":"state"
                        },
			 {"name":"date"},
		       {"name":"beds_icu_covid"}
	 ]
        },
	{
         "urldata": "https://zenodo.org/records/23698918/files/moh_vax_state.csv?content",
         "urlparent":"https://raw.githubusercontent.com/MoH-Malaysia/covid19-public/main/epidemic/moh_vax_state.csv",
         "archiveonly":"the file was renamed upstream (vaccination/vax_state.csv), its columns not yet checked",
         "separator":",",
         "columns": [
                        {
                   "name":"where",
                   "alias":"state"
                        },
			 {"name":"date"},
                       {"name":"vax","alias":"daily_partial"}
	 ]
	}
  ]
}  
